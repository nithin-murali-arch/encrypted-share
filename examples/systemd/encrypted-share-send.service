[Unit]
Description=Send field device logs over encrypted TCP
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=oneshot
User=encrypted-share
ExecStart=/usr/local/bin/encrypted-share send /var/log/field-device --config /etc/encrypted-share/send.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
TimeoutStartSec=30min
