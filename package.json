{
  "name": "@nithin93/encrypted-share",
  "version": "2.0.1",
  "description": "Encrypted file transfer CLI and Node.js library: send files and folders over TCP with AES-256-GCM, resume, SHA-256 checks.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "encrypted-share": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src tests",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "DESIGN.md"
  ],
  "keywords": [
    "encrypted-file-transfer",
    "file-transfer",
    "send-files",
    "file-sharing",
    "share-files",
    "folder-transfer",
    "aes-256-gcm",
    "encryption",
    "tcp",
    "resumable",
    "checksum",
    "sha256",
    "cli",
    "typescript"
  ],
  "author": "Nithin Murali <nithintecharch@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nithin-murali-arch/encrypted-share"
  },
  "bugs": {
    "url": "https://github.com/nithin-murali-arch/encrypted-share/issues"
  },
  "homepage": "https://github.com/nithin-murali-arch/encrypted-share#readme",
  "dependencies": {
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.2",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.17.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.6.0"
  }
}
